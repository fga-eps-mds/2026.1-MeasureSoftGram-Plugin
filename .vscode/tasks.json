{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build:webview",
			"type": "shell",
			"command": "source ~/.nvm/nvm.sh && nvm use 20 && npm run build:webview",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "compile:extension",
			"type": "npm",
			"script": "compile",
			"problemMatcher": "$tsc",
			"presentation": {
				"reveal": "never"
			}
		},
		{
			"label": "build:all",
			"dependsOrder": "sequence",
			"dependsOn": ["build:webview", "compile:extension"],
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "watch:extension",
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			}
		}
	]
}
